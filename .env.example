# Database connection string (Turso libsql://, Supabase postgres://, or leave empty for local cars.db)
DATABASE_URL=

# OpenRouter API key for AI Copilot (/api/ai/compare)
OPENROUTER_API_KEY=

# HTTP server port
PORT=8080

# Optional Google Cloud Storage thumbnail bucket (jobs) and public HTTPS base URL (web API)
# Leave empty to skip GCS thumbnail uploads / fall back directly to Crautos URLs.
THUMBS_BUCKET=
THUMBS_PUBLIC_BASE=

# Telegram alerts for saved searches
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=carros_usados_alertas_bot
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
